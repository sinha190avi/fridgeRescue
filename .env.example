APP_NAME=FridgeRescue
APP_ENV=development
APP_URL=http://localhost/fridgerescue

# Database (Local XAMPP default)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fridgerescue
DB_USER=root
DB_PASS=

